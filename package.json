{
  "name": "tomarigi-desktop",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build:verify": "sh scripts/build-verify.sh",
    "dev:web": "vite",
    "build": "bun run gen:locales && bun run verify:locales && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/ && cd src-tauri && cargo test --lib",
    "gen:locales": "node scripts/gen-locales.mjs",
    "verify:locales": "node scripts/verify-locales.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "idb": "^8.0.3",
    "motion": "^13.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "^2"
  }
}
